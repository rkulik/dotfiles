# Set PATH so it includes user's private bin if it exists
if [ -d "${HOME}/bin" ]; then
    PATH="${HOME}/bin:${PATH}"
fi

# Add ~/.local/bin to PATH if it exists
if [ -d "${HOME}/.local/bin" ]; then
    PATH="${HOME}/.local/bin:${PATH}"
fi

# Add pnpm's global bin to PATH if it exists
export PNPM_HOME="${HOME}/.local/share/pnpm"
if [ -d "${PNPM_HOME}/bin" ]; then
    case ":${PATH}:" in
    *":${PNPM_HOME}/bin:"*) ;;
    *) PATH="${PNPM_HOME}/bin:${PATH}" ;;
    esac
fi

t() {
    local name width height session
    local -a nameArgument

    name="$1"

    if [ -n "${name}" ] && tmux has-session -t "=${name}" 2>/dev/null; then
        if [ -n "${TMUX}" ]; then
            tmux switch-client -t "=${name}"
        else
            tmux attach-session -t "=${name}"
        fi

        return
    fi

    if [ -n "${name}" ]; then
        nameArgument=(-s "${name}")
    fi

    # Inside tmux tput reports the pane size, not the terminal size
    if [ -n "${TMUX}" ]; then
        width="$(tmux display-message -p '#{client_width}')"
        height="$(tmux display-message -p '#{client_height}')"
    else
        width="$(tput cols)"
        height="$(tput lines)"
    fi

    session="$(tmux new-session -dP -F '#{session_id}' \
        -x "${width}" -y "${height}" "${nameArgument[@]}")"

    tmux split-window -h -l 70% -t "${session}:" \
        \; split-window -v -l 50% -t "${session}:.0" \
        \; select-pane -R -t "${session}:"

    if [ -n "${TMUX}" ]; then
        tmux switch-client -t "${session}"
    else
        tmux attach-session -t "${session}"
    fi
}

tag() {
    if [ ! $(git rev-parse --is-inside-work-tree 2>/dev/null) ]; then
        echo "You have to be inside a git repository!"
        return
    fi

    echo -n "Tag: "
    read tag
    if [[ (-z "${tag}") ]]; then
        echo "Tag is required!"
        return
    fi

    echo -n "Annotate the tag? (y/n): "
    read answer

    case ${answer} in
    [Yy] | [Yy][Ee][Ss])
        echo -n "Message: "
        read message
        if [[ (-z "${message}") ]]; then
            echo "Message is required!"
            return
        fi

        git tag -a ${tag} -m "${message}"
        git push origin ${tag}
        ;;
    [Nn] | [Nn][Oo])
        git tag ${tag}
        git push origin ${tag}
        ;;
    *)
        echo "Invalid input! Enter 'y' or 'n'."
        ;;
    esac
}

weather() {
    echo -n "City: "
    read city
    curl http://wttr.in/${city// /+}
}

port() {
    echo -n "Port: "
    read port
    if [[ (-z "${port}") ]]; then
        echo "Port is required!"
        return
    fi

    lsof -i :${port}
}

